# Required: your bot token from the Discord developer portal
DISCORD_TOKEN=

# Optional: your server's ID. Commands appear instantly instead of within an hour.
GUILD_ID=

# Optional: channel ID for the daily problem reports and the Friday leaderboard
LEAGUE_CHANNEL_ID=

# Optional: free Alpaca keys for live prices during market hours.
# Without them the bot uses Yahoo Finance and trading is closed while the market is open.
ALPACA_API_KEY=
ALPACA_API_SECRET=
# Set to iex if bars fail with a 403 (your plan may not include SIP data)
ALPACA_BARS_FEED=sip
